{
  "mailer_subjects_confirmation": "Confirm your RoughBid account",
  "mailer_templates_confirmation_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"light\"><title>Confirm your RoughBid account</title></head>\n<body style=\"margin:0;padding:0;background:#f1f5f9;font-family:Arial,Helvetica,sans-serif;color:#0f172a\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#f1f5f9\"><tr><td align=\"center\" style=\"padding:32px 16px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:600px;background:#ffffff;border:1px solid #e2e8f0;border-radius:12px\"><tr><td style=\"padding:32px\">\n<img src=\"https://roughbid.vercel.app/brand/roughbid-logo-email.png\" width=\"190\" alt=\"RoughBid\" style=\"display:block;width:190px;max-width:100%;height:auto;border:0;margin:0 0 32px\">\n<h1 style=\"margin:0 0 18px;font-size:25px;line-height:32px;font-weight:700\">Welcome to RoughBid</h1>\n<p style=\"margin:0;font-size:15px;line-height:25px;color:#475569\">Confirm your email address to finish creating your account.</p>\n<p style=\"margin:28px 0\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#2563eb;color:#ffffff;padding:14px 22px;text-decoration:none;border-radius:6px;font-weight:700\">Confirm email address</a></p><p style=\"font-size:12px;line-height:20px;color:#64748b;word-break:break-all\">If the button does not work, copy this link into your browser:<br><a href=\"{{ .ConfirmationURL }}\" style=\"color:#2563eb\">{{ .ConfirmationURL }}</a></p>\n<p style=\"margin:28px 0 0;padding-top:20px;border-top:1px solid #e2e8f0;font-size:12px;line-height:20px;color:#64748b\">If you did not request this, you can ignore this email. Never forward a sign-in link or verification code.</p>\n</td></tr></table>\n<p style=\"margin:20px 0 0;font-size:12px;color:#64748b\">RoughBid · Secure account access</p>\n</td></tr></table></body></html>\n",
  "mailer_subjects_magic_link": "Your secure RoughBid sign-in link",
  "mailer_templates_magic_link_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"light\"><title>Your secure RoughBid sign-in link</title></head>\n<body style=\"margin:0;padding:0;background:#f1f5f9;font-family:Arial,Helvetica,sans-serif;color:#0f172a\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#f1f5f9\"><tr><td align=\"center\" style=\"padding:32px 16px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:600px;background:#ffffff;border:1px solid #e2e8f0;border-radius:12px\"><tr><td style=\"padding:32px\">\n<img src=\"https://roughbid.vercel.app/brand/roughbid-logo-email.png\" width=\"190\" alt=\"RoughBid\" style=\"display:block;width:190px;max-width:100%;height:auto;border:0;margin:0 0 32px\">\n<h1 style=\"margin:0 0 18px;font-size:25px;line-height:32px;font-weight:700\">Sign in to RoughBid</h1>\n<p style=\"margin:0;font-size:15px;line-height:25px;color:#475569\">Use this secure, single-use link to open your account.</p>\n<p style=\"margin:28px 0\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#2563eb;color:#ffffff;padding:14px 22px;text-decoration:none;border-radius:6px;font-weight:700\">Sign in to RoughBid</a></p><p style=\"font-size:12px;line-height:20px;color:#64748b;word-break:break-all\">If the button does not work, copy this link into your browser:<br><a href=\"{{ .ConfirmationURL }}\" style=\"color:#2563eb\">{{ .ConfirmationURL }}</a></p>\n<p style=\"margin:28px 0 0;padding-top:20px;border-top:1px solid #e2e8f0;font-size:12px;line-height:20px;color:#64748b\">If you did not request this, you can ignore this email. Never forward a sign-in link or verification code.</p>\n</td></tr></table>\n<p style=\"margin:20px 0 0;font-size:12px;color:#64748b\">RoughBid · Secure account access</p>\n</td></tr></table></body></html>\n",
  "mailer_subjects_recovery": "Reset your RoughBid password",
  "mailer_templates_recovery_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"light\"><title>Reset your RoughBid password</title></head>\n<body style=\"margin:0;padding:0;background:#f1f5f9;font-family:Arial,Helvetica,sans-serif;color:#0f172a\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#f1f5f9\"><tr><td align=\"center\" style=\"padding:32px 16px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:600px;background:#ffffff;border:1px solid #e2e8f0;border-radius:12px\"><tr><td style=\"padding:32px\">\n<img src=\"https://roughbid.vercel.app/brand/roughbid-logo-email.png\" width=\"190\" alt=\"RoughBid\" style=\"display:block;width:190px;max-width:100%;height:auto;border:0;margin:0 0 32px\">\n<h1 style=\"margin:0 0 18px;font-size:25px;line-height:32px;font-weight:700\">Reset your password</h1>\n<p style=\"margin:0;font-size:15px;line-height:25px;color:#475569\">You requested a password reset for your RoughBid account. Continue to choose a new password.</p>\n<p style=\"margin:28px 0\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#2563eb;color:#ffffff;padding:14px 22px;text-decoration:none;border-radius:6px;font-weight:700\">Reset password</a></p><p style=\"font-size:12px;line-height:20px;color:#64748b;word-break:break-all\">If the button does not work, copy this link into your browser:<br><a href=\"{{ .ConfirmationURL }}\" style=\"color:#2563eb\">{{ .ConfirmationURL }}</a></p>\n<p style=\"margin:28px 0 0;padding-top:20px;border-top:1px solid #e2e8f0;font-size:12px;line-height:20px;color:#64748b\">If you did not request this, you can ignore this email. Never forward a sign-in link or verification code.</p>\n</td></tr></table>\n<p style=\"margin:20px 0 0;font-size:12px;color:#64748b\">RoughBid · Secure account access</p>\n</td></tr></table></body></html>\n",
  "mailer_subjects_invite": "You are invited to RoughBid",
  "mailer_templates_invite_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"light\"><title>You are invited to RoughBid</title></head>\n<body style=\"margin:0;padding:0;background:#f1f5f9;font-family:Arial,Helvetica,sans-serif;color:#0f172a\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#f1f5f9\"><tr><td align=\"center\" style=\"padding:32px 16px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:600px;background:#ffffff;border:1px solid #e2e8f0;border-radius:12px\"><tr><td style=\"padding:32px\">\n<img src=\"https://roughbid.vercel.app/brand/roughbid-logo-email.png\" width=\"190\" alt=\"RoughBid\" style=\"display:block;width:190px;max-width:100%;height:auto;border:0;margin:0 0 32px\">\n<h1 style=\"margin:0 0 18px;font-size:25px;line-height:32px;font-weight:700\">Your RoughBid invitation</h1>\n<p style=\"margin:0;font-size:15px;line-height:25px;color:#475569\">You have been invited to create a RoughBid account. Confirm your email to continue.</p>\n<p style=\"margin:28px 0\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#2563eb;color:#ffffff;padding:14px 22px;text-decoration:none;border-radius:6px;font-weight:700\">Accept invitation</a></p><p style=\"font-size:12px;line-height:20px;color:#64748b;word-break:break-all\">If the button does not work, copy this link into your browser:<br><a href=\"{{ .ConfirmationURL }}\" style=\"color:#2563eb\">{{ .ConfirmationURL }}</a></p>\n<p style=\"margin:28px 0 0;padding-top:20px;border-top:1px solid #e2e8f0;font-size:12px;line-height:20px;color:#64748b\">If you did not request this, you can ignore this email. Never forward a sign-in link or verification code.</p>\n</td></tr></table>\n<p style=\"margin:20px 0 0;font-size:12px;color:#64748b\">RoughBid · Secure account access</p>\n</td></tr></table></body></html>\n",
  "mailer_subjects_email_change": "Confirm your RoughBid email change",
  "mailer_templates_email_change_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"light\"><title>Confirm your RoughBid email change</title></head>\n<body style=\"margin:0;padding:0;background:#f1f5f9;font-family:Arial,Helvetica,sans-serif;color:#0f172a\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#f1f5f9\"><tr><td align=\"center\" style=\"padding:32px 16px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:600px;background:#ffffff;border:1px solid #e2e8f0;border-radius:12px\"><tr><td style=\"padding:32px\">\n<img src=\"https://roughbid.vercel.app/brand/roughbid-logo-email.png\" width=\"190\" alt=\"RoughBid\" style=\"display:block;width:190px;max-width:100%;height:auto;border:0;margin:0 0 32px\">\n<h1 style=\"margin:0 0 18px;font-size:25px;line-height:32px;font-weight:700\">Confirm your email change</h1>\n<p style=\"margin:0;font-size:15px;line-height:25px;color:#475569\">Confirm the requested change from {{ .Email }} to {{ .NewEmail }}.</p>\n<p style=\"margin:28px 0\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#2563eb;color:#ffffff;padding:14px 22px;text-decoration:none;border-radius:6px;font-weight:700\">Confirm email change</a></p><p style=\"font-size:12px;line-height:20px;color:#64748b;word-break:break-all\">If the button does not work, copy this link into your browser:<br><a href=\"{{ .ConfirmationURL }}\" style=\"color:#2563eb\">{{ .ConfirmationURL }}</a></p>\n<p style=\"margin:28px 0 0;padding-top:20px;border-top:1px solid #e2e8f0;font-size:12px;line-height:20px;color:#64748b\">If you did not request this, you can ignore this email. Never forward a sign-in link or verification code.</p>\n</td></tr></table>\n<p style=\"margin:20px 0 0;font-size:12px;color:#64748b\">RoughBid · Secure account access</p>\n</td></tr></table></body></html>\n",
  "mailer_subjects_reauthentication": "Your RoughBid verification code",
  "mailer_templates_reauthentication_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"light\"><title>Your RoughBid verification code</title></head>\n<body style=\"margin:0;padding:0;background:#f1f5f9;font-family:Arial,Helvetica,sans-serif;color:#0f172a\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#f1f5f9\"><tr><td align=\"center\" style=\"padding:32px 16px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:600px;background:#ffffff;border:1px solid #e2e8f0;border-radius:12px\"><tr><td style=\"padding:32px\">\n<img src=\"https://roughbid.vercel.app/brand/roughbid-logo-email.png\" width=\"190\" alt=\"RoughBid\" style=\"display:block;width:190px;max-width:100%;height:auto;border:0;margin:0 0 32px\">\n<h1 style=\"margin:0 0 18px;font-size:25px;line-height:32px;font-weight:700\">Verify your identity</h1>\n<p style=\"margin:0;font-size:15px;line-height:25px;color:#475569\">Use the following code to confirm the action you requested in RoughBid. Do not share this code with anyone.</p>\n<p style=\"font-size:30px;letter-spacing:6px;font-weight:700;color:#0f172a\">{{ .Token }}</p>\n<p style=\"margin:28px 0 0;padding-top:20px;border-top:1px solid #e2e8f0;font-size:12px;line-height:20px;color:#64748b\">If you did not request this, you can ignore this email. Never forward a sign-in link or verification code.</p>\n</td></tr></table>\n<p style=\"margin:20px 0 0;font-size:12px;color:#64748b\">RoughBid · Secure account access</p>\n</td></tr></table></body></html>\n",
  "mailer_subjects_password_changed_notification": "Your RoughBid password was changed",
  "mailer_templates_password_changed_notification_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"light\"><title>Your RoughBid password was changed</title></head>\n<body style=\"margin:0;padding:0;background:#f1f5f9;font-family:Arial,Helvetica,sans-serif;color:#0f172a\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#f1f5f9\"><tr><td align=\"center\" style=\"padding:32px 16px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:600px;background:#ffffff;border:1px solid #e2e8f0;border-radius:12px\"><tr><td style=\"padding:32px\">\n<img src=\"https://roughbid.vercel.app/brand/roughbid-logo-email.png\" width=\"190\" alt=\"RoughBid\" style=\"display:block;width:190px;max-width:100%;height:auto;border:0;margin:0 0 32px\">\n<h1 style=\"margin:0 0 18px;font-size:25px;line-height:32px;font-weight:700\">Your password was changed</h1>\n<p style=\"margin:0;font-size:15px;line-height:25px;color:#475569\">The password for your RoughBid account was changed. If this was not you, review your account access and contact support.</p>\n\n<p style=\"margin:28px 0 0;padding-top:20px;border-top:1px solid #e2e8f0;font-size:12px;line-height:20px;color:#64748b\">This is an account security notification from RoughBid.</p>\n</td></tr></table>\n<p style=\"margin:20px 0 0;font-size:12px;color:#64748b\">RoughBid · Secure account access</p>\n</td></tr></table></body></html>\n",
  "mailer_subjects_email_changed_notification": "Your RoughBid email address was changed",
  "mailer_templates_email_changed_notification_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"light\"><title>Your RoughBid email address was changed</title></head>\n<body style=\"margin:0;padding:0;background:#f1f5f9;font-family:Arial,Helvetica,sans-serif;color:#0f172a\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#f1f5f9\"><tr><td align=\"center\" style=\"padding:32px 16px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:600px;background:#ffffff;border:1px solid #e2e8f0;border-radius:12px\"><tr><td style=\"padding:32px\">\n<img src=\"https://roughbid.vercel.app/brand/roughbid-logo-email.png\" width=\"190\" alt=\"RoughBid\" style=\"display:block;width:190px;max-width:100%;height:auto;border:0;margin:0 0 32px\">\n<h1 style=\"margin:0 0 18px;font-size:25px;line-height:32px;font-weight:700\">Your email address was changed</h1>\n<p style=\"margin:0;font-size:15px;line-height:25px;color:#475569\">Your RoughBid email address was changed from {{ .OldEmail }} to {{ .Email }}. If this was not you, review your account access and contact support.</p>\n\n<p style=\"margin:28px 0 0;padding-top:20px;border-top:1px solid #e2e8f0;font-size:12px;line-height:20px;color:#64748b\">This is an account security notification from RoughBid.</p>\n</td></tr></table>\n<p style=\"margin:20px 0 0;font-size:12px;color:#64748b\">RoughBid · Secure account access</p>\n</td></tr></table></body></html>\n",
  "mailer_subjects_phone_changed_notification": "Your RoughBid phone number was changed",
  "mailer_templates_phone_changed_notification_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"light\"><title>Your RoughBid phone number was changed</title></head>\n<body style=\"margin:0;padding:0;background:#f1f5f9;font-family:Arial,Helvetica,sans-serif;color:#0f172a\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#f1f5f9\"><tr><td align=\"center\" style=\"padding:32px 16px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:600px;background:#ffffff;border:1px solid #e2e8f0;border-radius:12px\"><tr><td style=\"padding:32px\">\n<img src=\"https://roughbid.vercel.app/brand/roughbid-logo-email.png\" width=\"190\" alt=\"RoughBid\" style=\"display:block;width:190px;max-width:100%;height:auto;border:0;margin:0 0 32px\">\n<h1 style=\"margin:0 0 18px;font-size:25px;line-height:32px;font-weight:700\">Your phone number was changed</h1>\n<p style=\"margin:0;font-size:15px;line-height:25px;color:#475569\">Your account phone number was changed from {{ .OldPhone }} to {{ .Phone }}. If this was not you, review your account access and contact support.</p>\n\n<p style=\"margin:28px 0 0;padding-top:20px;border-top:1px solid #e2e8f0;font-size:12px;line-height:20px;color:#64748b\">This is an account security notification from RoughBid.</p>\n</td></tr></table>\n<p style=\"margin:20px 0 0;font-size:12px;color:#64748b\">RoughBid · Secure account access</p>\n</td></tr></table></body></html>\n",
  "mailer_subjects_identity_linked_notification": "A sign-in method was added to RoughBid",
  "mailer_templates_identity_linked_notification_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"light\"><title>A sign-in method was added to RoughBid</title></head>\n<body style=\"margin:0;padding:0;background:#f1f5f9;font-family:Arial,Helvetica,sans-serif;color:#0f172a\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#f1f5f9\"><tr><td align=\"center\" style=\"padding:32px 16px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:600px;background:#ffffff;border:1px solid #e2e8f0;border-radius:12px\"><tr><td style=\"padding:32px\">\n<img src=\"https://roughbid.vercel.app/brand/roughbid-logo-email.png\" width=\"190\" alt=\"RoughBid\" style=\"display:block;width:190px;max-width:100%;height:auto;border:0;margin:0 0 32px\">\n<h1 style=\"margin:0 0 18px;font-size:25px;line-height:32px;font-weight:700\">A sign-in method was added</h1>\n<p style=\"margin:0;font-size:15px;line-height:25px;color:#475569\">Your {{ .Provider }} account was linked as a sign-in method for {{ .Email }}. If this was not you, review your account access and contact support.</p>\n\n<p style=\"margin:28px 0 0;padding-top:20px;border-top:1px solid #e2e8f0;font-size:12px;line-height:20px;color:#64748b\">This is an account security notification from RoughBid.</p>\n</td></tr></table>\n<p style=\"margin:20px 0 0;font-size:12px;color:#64748b\">RoughBid · Secure account access</p>\n</td></tr></table></body></html>\n",
  "mailer_subjects_identity_unlinked_notification": "A sign-in method was removed from RoughBid",
  "mailer_templates_identity_unlinked_notification_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"light\"><title>A sign-in method was removed from RoughBid</title></head>\n<body style=\"margin:0;padding:0;background:#f1f5f9;font-family:Arial,Helvetica,sans-serif;color:#0f172a\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#f1f5f9\"><tr><td align=\"center\" style=\"padding:32px 16px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:600px;background:#ffffff;border:1px solid #e2e8f0;border-radius:12px\"><tr><td style=\"padding:32px\">\n<img src=\"https://roughbid.vercel.app/brand/roughbid-logo-email.png\" width=\"190\" alt=\"RoughBid\" style=\"display:block;width:190px;max-width:100%;height:auto;border:0;margin:0 0 32px\">\n<h1 style=\"margin:0 0 18px;font-size:25px;line-height:32px;font-weight:700\">A sign-in method was removed</h1>\n<p style=\"margin:0;font-size:15px;line-height:25px;color:#475569\">Your {{ .Provider }} account was removed as a sign-in method for {{ .Email }}. If this was not you, review your account access and contact support.</p>\n\n<p style=\"margin:28px 0 0;padding-top:20px;border-top:1px solid #e2e8f0;font-size:12px;line-height:20px;color:#64748b\">This is an account security notification from RoughBid.</p>\n</td></tr></table>\n<p style=\"margin:20px 0 0;font-size:12px;color:#64748b\">RoughBid · Secure account access</p>\n</td></tr></table></body></html>\n",
  "mailer_subjects_mfa_factor_enrolled_notification": "A verification method was added to RoughBid",
