# Supabase — public values read by the /api Edge Functions (api/[...path].ts
# -> apps/api/src/http/handler.ts). This is the anon/publishable key, safe to
# be server-side config — RLS (supabase/migrations/) is the real authorization
# boundary, not this key. Never put the service-role key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Supabase — same public values, read by the browser bundle for apps/web/app
# (see src/services/supabaseClient.ts). Vite only exposes VITE_-prefixed vars
# to client code, so these are a separate pair from the ones above even
# though the values are identical.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase — server only
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — server only. Per-project Checkout uses server-generated price_data;
# STRIPE_PRICE_ID is only a legacy/membership catalog fallback. LIVE mode still
# requires the matching LIVE API key and dedicated signed webhook secret.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRODUCT_ID=prod_VB3s2SIgOAxwRR
STRIPE_PRICE_ID=

# Resend — server only
RESEND_API_KEY=
# Optional verified sender (email address or Name <email>). Leave blank to keep
# RoughBid <hello@mail.kspdominion.group>. Change only after Resend verifies its domain.
RESEND_FROM_EMAIL=
# Template aliases remain fixed in server code; never use a NEXT_PUBLIC_ prefix.

# Application
# Public HTTPS origin used for application links and transactional email logos.
APP_URL=

# apps/web/app — public value, safe to expose in the browser bundle. Leave
# empty to keep the app running on local mock data (see apps/web/app/README.md
# and src/services/api.ts). No keys or passwords belong in this file.
VITE_API_BASE_URL=

# Private S3-compatible object storage (AWS S3 or Cloudflare R2) — server only
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=roughbid-documents
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
# Optional CDN/custom domain for generated, non-sensitive page assets
OBJECT_STORAGE_PUBLIC_ASSET_URL=

# Optional server page images; original upload/preview works without Redis.
PDF_PAGE_PROCESSING_ENABLED=false
REDIS_URL=

# Durable AI plan execution. Leave false until a continuously running
# `npm run worker` deployment is verified against the same Redis + Supabase.
# When true, POST /ai-plan-readings returns 202 only if a live worker heartbeat
# and BullMQ worker are both visible; otherwise it fails closed before reserve.
AI_PLAN_DURABLE_ENABLED=false

# Full Takeoff V2 / Claude Deep — server/worker only. These gates stay closed
# until the foundation schema, durable worker, exact Claude model, and the
# model's adaptive-thinking/high-effort behavior are verified together.
TAKEOFF_V2_ENABLED=false
TAKEOFF_V2_WORKER_ENABLED=false
TAKEOFF_V2_SCHEMA_VERSION=
TAKEOFF_V2_CLAUDE_ENABLED=false
TAKEOFF_V2_CLAUDE_ADAPTIVE_HIGH_VERIFIED=false
ANTHROPIC_API_KEY=
TAKEOFF_V2_CLAUDE_MODEL=

# Mapify MCP — server only
MAPIFY_API_KEY=
MAPIFY_API_BASE_URL=

# Paid AI plan readers — server only. Failure returns no invented output.
# Gemini remains the current PDF-native production reader.
PAID_PLAN_READINGS_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=

# Claude plan reader — server only, PDF-native. Stays closed until the flag is
# true and CLAUDE_PLAN_MODEL is an exact claude-<family>-... name. Metered
# through the same company provider-spend breaker as the other paid readers.
CLAUDE_PLAN_READING_ENABLED=false
CLAUDE_PLAN_MODEL=

# OpenAI plan reader — server only. Reads the plan PDF directly (so no page
# renderer is required) and prefers rendered page images when present.
OPENAI_PLAN_READING_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional. Must stay an approved HTTPS API host; anything else is refused.
OPENAI_BASE_URL=

# Local PDF vector linework (lines, wall runs, closed shapes) is measured in
# process at no cost and shared with every reader. Set false to disable it.
# AI_PLAN_LINEWORK_MAX_PAGES must cover the whole set (up to 100 physical pages
# are accepted): a lower limit leaves later sheets with no measured geometry,
# which is disclosed as a reading limitation.
AI_PLAN_VECTOR_LINEWORK_ENABLED=true
AI_PLAN_LINEWORK_MAX_PAGES=100

# The sheet's printed text layer (notes, keynotes, tags, schedules, title
# blocks) is transcribed in process at no cost and shared with every reader.
AI_PLAN_SHEET_TEXT_ENABLED=true
AI_PLAN_SHEET_TEXT_MAX_PAGES=80
AI_PLAN_SHEET_TEXT_MAX_CHARS=30000
AI_PLAN_SHEET_TEXT_MAX_CHARS_PER_PAGE=1500

# Whole-set reading: a large set is read one request per window, restoring
# physical page numbers. Each request is metered on its own, and any page a
# reader never read is disclosed in the reading's limitations.
# Setting the matching *_SWEEP=false sends the whole set in a single request.
AI_PLAN_GEMINI_BATCH_PAGES=8
AI_PLAN_GEMINI_MAX_BATCHES=25
AI_PLAN_GEMINI_SWEEP=true
AI_PLAN_OPENAI_BATCH_PAGES=8
AI_PLAN_OPENAI_MAX_BATCHES=25
AI_PLAN_OPENAI_SWEEP=true
# Per-request ceiling. A multi-page PDF legitimately takes 15-30 s; a hard 60 s
# turned a slow reading into a failed one. 120000 default, 300000 max.
AI_PLAN_GEMINI_TIMEOUT_MS=120000
AI_PLAN_OPENAI_TIMEOUT_MS=120000
AI_PLAN_MAX_TOTAL_FINDINGS=400

# A sweep runs inline in the HTTP request, so the platform's function timeout is
# a hard ceiling on the whole reading. This deadline must sit BELOW your deployed
# function's maxDuration, or the platform kills the request mid-sweep and nothing
# is saved. Vercel: set `functions` -> `maxDuration` in vercel.json (Pro allows
# 300 s). On Hobby (60 s cap) use 50000 here, and expect large sets to be read
# only up to the deadline, with the unread pages named in the reading.
# 0 disables the deadline and is only safe on the durable worker (no HTTP
# timeout): AI_PLAN_DURABLE_ENABLED=true.
AI_PLAN_SWEEP_BUDGET_MS=240000


# Provider order is evaluated left-to-right. DeepSeek/Kimi require rendered page images;
# if those images are unavailable they fail closed before any provider request, then the
# next configured reader is tried. Keep both new providers disabled until benchmarked.
AI_PLAN_PROVIDER_ORDER=gemini,claude,openai,kimi,deepseek
LOW_COST_VISION_MAX_PAGES=8

# DeepSeek V4.1 Flash vision — cheapest first-pass candidate.
DEEPSEEK_PLAN_READING_ENABLED=false
# Separate privacy gate for private/customer plan data. Keep false until the
# applicable provider data-use/opt-out posture is explicitly accepted.
DEEPSEEK_PRIVATE_PLAN_DATA_APPROVED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Kimi vision — cost-optimized fallback. For US/international Open Platform keys use
# https://api.moonshot.ai/v1; China Open Platform keys use https://api.moonshot.cn/v1.
# The key and endpoint region MUST match. K2.6 is intentionally cheaper than K3.
KIMI_PLAN_READING_ENABLED=false
KIMI_API_KEY=
KIMI_BASE_URL=
KIMI_MODEL=kimi-k2.6

# Owner-only free provider — server/worker only. The free credential must be
# isolated from GEMINI_API_KEY and manually verified before activation.
FREE_OWNER_READINGS_ENABLED=false
FREE_OWNER_WORKSPACE_ID=
FREE_PROVIDER_ENABLED=false
GEMINI_FREE_API_KEY=
GEMINI_FREE_MODEL=
GEMINI_FREE_PROJECT_ID=
GEMINI_FREE_TIER_VERIFIED=false

# Measured processing cost policy: includes both attempts, storage, support and overhead.
# Leave blank until measured and approved. Missing configuration disables project checkout.
PROJECT_PRICING_VERSION=
PROJECT_COST_BASE_CENTS=
PROJECT_COST_PAGE_CENTS=
PROJECT_COST_TRADE_CENTS=
PROJECT_PAYMENT_FIXED_CENTS=
PROJECT_PAYMENT_FEE_BPS=
# Subscription checkout stays disabled until monthly prices are approved.
BILLING_MEMBERSHIPS_ENABLED=false
STRIPE_PRICE_PLAN_STARTER=
STRIPE_PRICE_PLAN_PRO=
STRIPE_PRICE_PLAN_TEAM=
STRIPE_PRICE_PLAN_ENTERPRISE=
# Marketplace is a separately gated subscription; do not enable this flag
# until its exact mode-specific Stripe Price and webhook are installed.
# First controlled-sales SKU: Supplier Price Import, $49/month,
# pricing version 2026-09-10-marketplace-v1.
# First commercial Marketplace SKU. Leave disabled until its matching Stripe
# price mapping, signed webhook, renewal, refund, and cancellation paths pass.
BILLING_MARKETPLACE_ENABLED=false
STRIPE_PRICE_MARKETPLACE_SUPPLIER_IMPORT=

# Additional paid-workspace request guard. The verified platform owner has a
# separate database-atomic 25-attempt rolling 24-hour cap; pilot users have
# their own atomic project and cost limits.
AI_PLAN_DAILY_JOB_LIMIT=25
# A second, company-wide rolling spend breaker is stored in Supabase
# provider_spend_policy and is required before every Gemini generation call.

# Limited access dashboard. Server secrets must never have a VITE_ prefix.
PILOT_READINGS_ENABLED=false
# Optional isolated key; otherwise uses the existing server GEMINI_API_KEY.
# Model and token/cost envelope are pinned in pilot-reader.ts.
GEMINI_PILOT_API_KEY=
PILOT_INVITE_SIGNING_SECRET=
# Vercel hourly expiry notices and signed Resend delivery webhook.
CRON_SECRET=
RESEND_WEBHOOK_SECRET=
