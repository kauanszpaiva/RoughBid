# Supabase — public values read by the /api Edge Functions (api/[...path].ts
# -> apps/api/src/http/handler.ts). This is the anon/publishable key, safe to
# be server-side config — RLS (supabase/migrations/) is the real authorization
# boundary, not this key. Never put the service-role key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Supabase — same public values, read by the browser bundle for apps/web/app
# (see src/services/supabaseClient.ts). Vite only exposes VITE_-prefixed vars
# to client code, so these are a separate pair from the ones above even
# though the values are identical.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase — server only
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — server only. LIVE mode is intentional for the official account,
# but checkout remains disabled until STRIPE_PRICE_ID is explicitly approved.
STRIPE_MODE=live
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRODUCT_ID=prod_VB3s2SIgOAxwRR
STRIPE_PRICE_ID=

# Resend — server only
RESEND_API_KEY=
# Sender and template alias are fixed in server code; never use a NEXT_PUBLIC_ prefix.

# Application
APP_URL=

# apps/web/app — public value, safe to expose in the browser bundle. Leave
# empty to keep the app running on local mock data (see apps/web/app/README.md
# and src/services/api.ts). No keys or passwords belong in this file.
VITE_API_BASE_URL=

# Private S3-compatible object storage (AWS S3 or Cloudflare R2) — server only
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=roughbid-documents
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
# Optional CDN/custom domain for generated, non-sensitive page assets
OBJECT_STORAGE_PUBLIC_ASSET_URL=

# Redis used by the BullMQ PDF worker — server only
REDIS_URL=

# Mapify MCP — server only
MAPIFY_API_KEY=
MAPIFY_API_BASE_URL=
