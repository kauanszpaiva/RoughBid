# Runs the RoughBid background worker (scripts/worker.ts): drains the
# pdf-processing BullMQ queue that renders uploaded plan PDFs to page images
# for the in-app blueprint viewer. This is the piece Vercel cannot host —
# deploy this image to any host that stays running (Railway, Fly.io, Render,
# a small always-on VM, ECS, etc.) alongside the Vercel app.
#
# AI plan reading does NOT need this container — it runs synchronously inline
# in the API request (see apps/api/src/ai-plan/service.ts and gemini.ts).
#
# Build:  docker build -f Dockerfile.worker -t roughbid-worker .
# Run:    docker run --env-file .env roughbid-worker
#
# Required env vars (see .env.example): REDIS_URL, SUPABASE_URL,
# SUPABASE_SERVICE_ROLE_KEY, OBJECT_STORAGE_*.
FROM node:22-bookworm-slim

# poppler-utils provides pdfinfo/pdftoppm, which PopplerPdfConverter
# (apps/api/src/documents/worker.ts) shells out to for PDF page rendering.
RUN apt-get update \
  && apt-get install -y --no-install-recommends poppler-utils \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY apps/api ./apps/api
COPY packages/domain ./packages/domain
COPY scripts/worker.ts ./scripts/worker.ts

USER node
CMD ["node", "--experimental-strip-types", "scripts/worker.ts"]
