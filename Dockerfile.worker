# Runs the RoughBid long-lived worker (scripts/worker.ts). It drains the
# pdf-processing queue and, when AI_PLAN_DURABLE_ENABLED=true, the durable
# ai-plan-reading BullMQ queue. Vercel functions are not a substitute for this
# process: deploy this image only on a host that explicitly supports continuously
# running workers (Railway, Fly.io, Render worker, VM, ECS, etc.).
#
# Build:  docker build -f Dockerfile.worker -t roughbid-worker .
# Run:    docker run --env-file .env roughbid-worker
#
# Base required env vars: REDIS_URL, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
# and either BLOB_READ_WRITE_TOKEN or OBJECT_STORAGE_*.
# AI jobs additionally require AI_PLAN_DURABLE_ENABLED=true and at least one
# explicitly configured/authorized Gemini provider (paid and/or isolated free).
FROM node:24-bookworm-slim

# poppler-utils provides pdfinfo/pdftoppm for optional server page rendering.
RUN apt-get update \
  && apt-get install -y --no-install-recommends poppler-utils \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY apps/api ./apps/api
COPY packages/domain ./packages/domain
COPY scripts/worker.ts ./scripts/worker.ts

USER node
CMD ["node", "--experimental-strip-types", "scripts/worker.ts"]
