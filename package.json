{
  "name": "roughbid-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.45.4",
    "@vercel/blob": "^2.8.0",
    "bullmq": "^5.58.5",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts packages/domain/test/*.test.ts apps/api/test/*.test.ts apps/mcp/mapify/*.test.ts apps/web/test/*.test.ts supabase/test/*.test.mjs prisma/*.test.mjs",
    "test:docusign": "node --experimental-strip-types --test tests/docusign-account-portability.test.ts",
    "test:domain": "node --experimental-strip-types --test packages/domain/test/*.test.ts",
    "test:api": "node --experimental-strip-types --test apps/api/test/*.test.ts",
    "test:web": "node --experimental-strip-types --test apps/web/test/*.test.ts",
    "dev:app": "vite --config apps/web/app/vite.config.ts",
    "build:app": "vite build --config apps/web/app/vite.config.ts",
    "test:mcp": "node --experimental-strip-types --test apps/mcp/mapify/*.test.ts",
    "build": "node scripts/build.mjs",
    "worker": "node --experimental-strip-types scripts/worker.ts",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:format": "prisma format --schema prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^5.0.4",
    "prisma": "6.12.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
